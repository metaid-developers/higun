  "paths": {
    "/ft/balance": {
      "get": {
        "summary": "Get FT Balance",
        "description": "Query FT balance for a specified address",
        "operationId": "getFtBalance",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "description": "Wallet address",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "codeHash",
            "in": "query",
            "description": "FT code hash",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genesis",
            "in": "query",
            "description": "FT genesis ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FtBalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
