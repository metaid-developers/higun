{
  "openapi": "3.0.0",
  "info": {
    "title": "HiGun API",
    "description": "HiGun is a MetaID-based UTXO indexer supporting FT (Fungible Token) and NFT (Non-Fungible Token) chain data queries.",
    "version": "1.0.0",
    "contact": {
      "name": "HiGun Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default server"
    }
