  "components": {
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object"
          },
          "time": {
            "type": "integer",
            "description": "Unix timestamp in milliseconds"
          },
          "cost": {
            "type": "integer",
            "description": "Processing time in milliseconds"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "code": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string"
          },
          "time": {
            "type": "integer"
          },
          "cost": {
            "type": "integer"
          }
        }
      },
      "FtBalanceResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "balances": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FtBalance"
                }
              }
            }
          },
          "time": {
            "type": "integer"
          },
          "cost": {
            "type": "integer"
          }
        }
      },
      "FtBalance": {
        "type": "object",
        "properties": {
          "codeHash": {
            "type": "string"
          },
          "genesis": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          },
          "satoshi": {
            "type": "string"
          }
        }
      },
      "FtUTXOsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "utxos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FtUTXO"
                }
              },
              "count": {
                "type": "integer"
              }
            }
          },
          "time": {
            "type": "integer"
          },
          "cost": {
            "type": "integer"
          }
        }
      },
      "FtUTXO": {
        "type": "object",
        "properties": {
          "codeHash": {
            "type": "string"
          },
          "genesis": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "sensibleId": {
            "type": "string"
          },
          "txid": {
            "type": "string"
          },
          "txIndex": {
            "type": "integer"
          },
          "valueString": {
            "type": "string"
          },
          "satoshiString": {
            "type": "string"
          },
          "height": {
            "type": "integer"
          },
          "address": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          }
        }
      },
      "FtGenesisResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
